---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label={siteTitle}>
  <img class="dark:sl-hidden" src="/brand/logo-light@8x.png" width="108" height="44" alt="" />
  <img class="light:sl-hidden" src="/brand/logo-dark@8x.png" width="108" height="44" alt="" />
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    width: fit-content;
  }

  .site-title img {
    width: 108px;
    height: 44px;
  }
</style>
