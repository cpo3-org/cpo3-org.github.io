---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
import VersionSelect from './VersionSelect.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="site-brand">
<a href={siteTitleHref} class="site-title" aria-label={siteTitle}>
  <img class="dark:sl-hidden" src={`${base}/brand/logo-light@8x.png`} width="108" height="44" alt="" />
  <img class="light:sl-hidden" src={`${base}/brand/logo-dark@8x.png`} width="108" height="44" alt="" />
</a>
<VersionSelect />
</div>

<style>
  .site-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-title {
    display: flex;
    align-items: center;
    width: fit-content;
  }

  .site-title img {
    width: 108px;
    height: 44px;
  }
</style>
