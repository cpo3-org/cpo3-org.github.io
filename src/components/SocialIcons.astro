---
import { Icon } from '@astrojs/starlight/components';
---

<a
  class="header-link"
  href="https://github.com/cpo3-org/cpo3"
  aria-label="cpo3 on GitHub"
>
  <Icon name="github" size="1.25rem" />
  <span>GitHub</span>
</a>
<a
  class="header-link"
  href="https://arxiv.org/abs/2611.18403"
  aria-label="Read the paper on arXiv"
>
  <Icon name="document" size="1.25rem" />
  <span>arXiv</span>
</a>

<style>
  .header-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem;
    margin: -0.5rem;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
