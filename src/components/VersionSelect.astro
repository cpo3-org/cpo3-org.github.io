---
import { currentVersion, versions, versionDestination } from '../../docs.config.mjs';
---

<label class="version-select">
  <span class="sr-only">Documentation version</span>
  <select aria-label="Documentation version">
    {versions.map((version) => {
      const destination = versionDestination(version, Astro.url.pathname);
      return <option value={destination.href} data-same-page={destination.samePage}
        selected={version.id === currentVersion.id}>{version.label}</option>;
    })}
  </select>
</label>

<script>
  document.querySelectorAll<HTMLSelectElement>('.version-select select').forEach((select) => {
    select.addEventListener('change', () => {
      const option = select.selectedOptions[0];
      const hash = option.dataset.samePage === 'true' ? window.location.hash : '';
      window.location.assign(option.value + hash);
    });
  });
</script>

<style>
  .version-select { display: flex; min-width: 0; }
  select {
    max-width: 8.5rem;
    padding: 0.35rem 0.1rem;
    border: 0;
    border-radius: 0.2rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  select:hover { color: var(--sl-color-white); }
  select:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  @media (max-width: 24rem) { select { max-width: 6.5rem; } }
</style>
